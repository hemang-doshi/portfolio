{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemang-portfolio",
  // worker.ts wraps the OpenNext fetch handler and adds the hourly cron.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hemang-portfolio" }],
  // Instagram token + feed snapshot (see src/lib/instagram-store.ts).
  "kv_namespaces": [{ "binding": "INSTAGRAM", "id": "14b27b72a5c64d25b2a2f6ff821894dd" }],
  // Hourly: rebuild the feed snapshot; rotate the token when it is a week old.
  "triggers": { "crons": ["23 * * * *"] },
  "observability": { "enabled": true },
  // INSTAGRAM_ACCESS_TOKEN is a secret (wrangler secret put), used only to seed KV.
  "routes": [
    { "pattern": "hemangbuilds.com", "custom_domain": true },
    { "pattern": "www.hemangbuilds.com", "custom_domain": true }
  ]
}
